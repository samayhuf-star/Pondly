{
  "expo": {
    "name": "Pondly",
    "slug": "pondly",
    "scheme": "pondly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E4F3FF",
    "ios": {
      "bundleIdentifier": "com.samay.pondly",
      "supportsTablet": false,
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#E4F3FF",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pondly uses your approximate location once a day to check today's weather and adapt your water goal."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F6FBF"
        }
      ],
      "expo-font"
    ],
    "owner": "krosz",
    "extra": {
      "eas": {
        "projectId": "3c3e4cf9-8737-45b1-8057-e0d694e955e8"
      }
    }
  }
}
